{
  "name": "perf-swarm",
  "version": "2.0.0",
  "description": "Reproducible multi-agent engineering experiments powered by native Codex",
  "type": "module",
  "bin": {
    "perf-swarm": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for (const name of ['gui-assets', 'browser-host', 'virtual-chrome']) require('node:fs').cpSync('src/'+name, 'dist/'+name, {recursive:true})\"",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "browser:chrome:build": "node src/virtual-chrome/build.mjs",
    "env:mps:setup": "bash scripts/setup-mps-env.sh",
    "env:mps:check": "python3 scripts/check-mps-env.py"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "electron": "^44.5.1",
    "playwright": "^1.63.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
